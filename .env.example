# РЎРєРѕРїРёСЂСѓР№С‚Рµ С„Р°Р№Р» РІ .env Рё Р·Р°РґР°Р№С‚Рµ СЃРІРѕРё Р·РЅР°С‡РµРЅРёСЏ.
# РЎРµРєСЂРµС‚РЅС‹Р№ РєР»СЋС‡ РјРѕР¶РЅРѕ СЃРіРµРЅРµСЂРёСЂРѕРІР°С‚СЊ РєРѕРјР°РЅРґРѕР№:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# DJANGO_DB_PATH=C:/path/to/db.sqlite3
# Р”Р»СЏ Р»РѕРєР°Р»СЊРЅРѕРіРѕ HTTP РѕСЃС‚Р°РІСЊС‚Рµ 0; Р·Р° HTTPS-РїСЂРѕРєСЃРё Р·Р°РґР°Р№С‚Рµ 1.
DJANGO_SECURE_SSL=0
DJANGO_HSTS_SECONDS=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
